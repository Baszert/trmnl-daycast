{%- comment -%}
  Daycast, shared code. Generated by dev/build.mjs from dev/shared.src.liquid and dev/weer.js; edit those.
  Open-Meteo comes in through the polling URL; the page draws the chart.
{%- endcomment -%}
<!--
  Daycast. Data flow: the polling URL (Open-Meteo forecast) gives hourly, daily and utc_offset_seconds; Liquid writes
  them into each view as JSON (script.wx-data, built in wx_json below) with the settings as data-* attributes (wx_attrs).
  The script at the bottom reads that JSON, fills the words in the header (data-wx="...") and draws the chart into
  svg.wx-svg: icons, temperature line, rain area, hours. The header, the svg and the JSON block are all it needs.
  Source: dev/weer.js and dev/shared.src.liquid (this file is built from them).
-->
{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
{%- capture wx_attrs -%}
data-ts="{{ trmnl.system.timestamp_utc }}" data-locale="{{ trmnl.user.locale | default: 'en' }}" data-lang="{{ cf.language | default: 'auto' }}" data-clock="{{ cf.clock | default: 'auto' }}" data-units="{{ cf.units | default: 'auto' }}" data-wind="{{ cf.wind | default: 'auto' }}" data-place="{{ cf.place_name | escape }}" data-ll="{{ cf.lat_lon | escape }}"
{%- endcapture -%}
{%- capture wx_json -%}
{"off":{{ utc_offset_seconds | json }},"h":{{ hourly | json }},"d":{{ daily | json }}}
{%- endcapture -%}


<style>
  /* Layout, colour and type come from TRMNL's classes in the views; the chart is drawn by the script. Only what the classes cannot do is here. */
  .wx-layout { padding: 0 !important; }
  .wx { --pad: 24px; --k: 1; position: relative; min-height: 0; overflow: hidden; }
  .screen--lg .wx { --pad: 31px; --k: 1.3; }
  .wx--half_horizontal, .wx--quadrant { --pad: 18px; } .screen--lg .wx--half_horizontal, .screen--lg .wx--quadrant { --pad: 24px; }
  .wx .hidden { display: none !important; }
  .wx-head { left: var(--pad); right: var(--pad); top: calc(var(--pad) - 4px); align-items: flex-start; gap: 16px; }
  .wx-main { min-width: 0; }
  .wx-now { gap: calc(14px * var(--k)); margin-top: calc(8px * var(--k)); }
  .wx-temp { letter-spacing: -0.04em; line-height: 0.9; }
  .wx-nowicon { width: calc(46px * var(--k)); height: calc(46px * var(--k)); flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .wx-words { min-width: 0; }
  .wx-stats { flex: none; margin-top: calc(4px * var(--k)); }
  /* smaller views */
  .wx--half_horizontal .wx-nowicon { width: calc(34px * var(--k)); height: calc(34px * var(--k)); }
  .wx--half_horizontal .wx-sub, .wx--half_horizontal .wx-date { display: none; }
  .wx--half_horizontal .wx-now { margin-top: calc(4px * var(--k)); }
  .wx--half_vertical .wx-head { flex-direction: column; gap: calc(16px * var(--k)); }
  .wx--half_vertical .wx-nowicon { width: calc(38px * var(--k)); height: calc(38px * var(--k)); }
  .wx--quadrant .wx-stats, .wx--quadrant .wx-date, .wx--quadrant .wx-sub { display: none; }
  .wx--quadrant .wx-nowicon { width: calc(30px * var(--k)); height: calc(30px * var(--k)); } .wx--quadrant .wx-now { margin-top: calc(2px * var(--k)); }
  /* narrow slots (portrait): the header stacks; very narrow ones put the sentence under the number and drop the second line */
  .wx--narrow .wx-head { flex-direction: column; gap: calc(14px * var(--k)); } .wx--narrow .wx-stats { margin-top: 0; }
  .wx--tiny .wx-now { flex-wrap: wrap; row-gap: calc(6px * var(--k)); } .wx--tiny .wx-words { flex-basis: 100%; }
  .wx--tiny .wx-sub, .wx--tiny .wx-date { display: none; } .wx--tiny .wx-stats { gap: calc(14px * var(--k)); }
  .screen--portrait .wx--full .wx-head { flex-direction: column; gap: calc(16px * var(--k)); }
  /* color screens: rain in blue, the temperature in red */
  [class*="screen--color-"] .wx .wx-rain { fill: var(--bg-blue-color, #aaa); }
  [class*="screen--color-"] .wx .wx-temp { stroke: var(--bg-red-color, #000); }
</style>

<script>{% raw %}/*SCRIPT*/{% endraw %}</script>

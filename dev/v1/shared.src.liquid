{%- comment -%}
  Daycast, shared code. Generated by dev/build.mjs from dev/shared.src.liquid and dev/weer.js; edit those.
  Open-Meteo comes in through the polling URL; the page draws the chart.
{%- endcomment -%}
{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
{%- capture wx_attrs -%}
data-ts="{{ trmnl.system.timestamp_utc }}" data-locale="{{ trmnl.user.locale | default: 'en' }}" data-lang="{{ cf.language | default: 'auto' }}" data-clock="{{ cf.clock | default: 'auto' }}" data-units="{{ cf.units | default: 'auto' }}" data-wind="{{ cf.wind | default: 'auto' }}" data-place="{{ cf.place_name | escape }}"
{%- endcapture -%}
{%- capture wx_json -%}
{"off":{{ utc_offset_seconds | json }},"h":{{ hourly | json }},"d":{{ daily | json }}}
{%- endcapture -%}
{%- capture wx_stats -%}
<div class="wx-stats">
  <div class="wx-stat"><span class="wx-stat-k"><svg class="wx-i" viewBox="0 0 24 24"><path d="M2.5 9h11a2.6 2.6 0 1 0-2.6-2.6M2.5 14h15a2.6 2.6 0 1 1-2.6 2.6"/></svg><span class="label label--small wx-up" data-wx="windl"></span></span><span class="value value--xsmall" data-wx="wind"></span></div>
  <div class="wx-stat"><span class="wx-stat-k"><svg class="wx-i" viewBox="0 0 24 24"><path d="M12 3.5s-6 6.6-6 10.6a6 6 0 0 0 12 0c0-4-6-10.6-6-10.6z"/></svg><span class="label label--small wx-up" data-wx="rainl"></span></span><span class="value value--xsmall" data-wx="rain"></span></div>
  <div class="wx-stat"><span class="wx-stat-k"><svg class="wx-i" viewBox="0 0 24 24" data-wx-icon="sun"></svg><span class="label label--small wx-up" data-wx="sunl"></span></span><span class="value value--xsmall" data-wx="sun"></span></div>
</div>
{%- endcapture -%}

<style>
  /* Full-bleed: the words on top, a calm chart below, drawn by the script. */
  .wx-layout { padding: 0 !important; }
  .wx { --pad: 20px; position: relative; width: 100%; height: 100%; min-height: 0; overflow: hidden; background: #fff; }
  .screen--lg .wx { --pad: 30px; }
  .wx--half_horizontal, .wx--quadrant { --pad: 14px; } .screen--lg .wx--half_horizontal, .screen--lg .wx--quadrant { --pad: 22px; }
  .wx-svg { position: absolute; inset: 0; display: block; }
  .wx .hidden { display: none !important; }
  .wx-head { position: absolute; left: var(--pad); right: var(--pad); top: var(--pad); display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .wx-main, .wx-words { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .wx-now { display: flex; align-items: center; gap: 14px; margin-top: 6px; }
  .wx-now .value { letter-spacing: -0.02em; }
  .wx .wx-up { text-transform: uppercase; letter-spacing: 0.1em; }
  /* wind, rain and sun: three columns with hairlines */
  .wx-stats { display: flex; margin-top: 2px; flex: none; }
  .wx-stat { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; padding: 1px 0 2px 14px; margin-left: 14px; border-left: 1.5px solid #000; }
  .wx-stat:first-child { border-left: 0; margin-left: 0; padding-left: 0; }
  .wx-stat-k { display: inline-flex; align-items: center; gap: 5px; }
  .wx-i { width: 15px; height: 15px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .screen--lg .wx-stat { gap: 8px; padding-left: 20px; margin-left: 20px; } .screen--lg .wx-stat:first-child { padding-left: 0; margin-left: 0; }
  .screen--lg .wx-i { width: 20px; height: 20px; } .screen--lg .wx-stat-k { gap: 7px; }
  /* text in the chart uses the framework's label fonts (pixel fonts on 1-bit, Inter on the X) */
  .wx-svg .t1 { font-family: var(--label-font-family); font-size: var(--label-font-size); font-weight: var(--label-font-weight); -webkit-font-smoothing: var(--label-font-smoothing); }
  .wx-svg .t2 { font-family: var(--label-small-font-family); font-size: var(--label-small-font-size); font-weight: var(--label-small-font-weight); -webkit-font-smoothing: var(--label-small-font-smoothing); }
  /* the X: two text sizes, small (kicker, labels, hours) and body (subtitle, times, values in the chart) */
  .screen--lg .wx-svg .t1 { font-family: var(--label-font-family); font-size: calc(var(--label-font-size) * 1.1); font-weight: 600; }
  .screen--lg .wx-svg .t2 { font-family: var(--label-font-family); font-size: var(--label-font-size); }
  .screen--lg .wx .wx-up { font-size: var(--label-font-size); }
  .screen--lg .wx [data-wx="sub"] { font-family: var(--label-font-family); font-size: calc(var(--label-font-size) * 1.1); font-weight: var(--label-font-weight); }
  /* smaller views */
  .wx--half_horizontal .wx-now { margin-top: 2px; gap: 10px; } .wx--half_horizontal [data-wx="sub"] { display: none; }
  .wx--half_vertical .wx-head { flex-direction: column; gap: 14px; } .wx--half_vertical .wx-stats { margin-top: 0; }
  .wx--quadrant .wx-stats, .wx--quadrant [data-wx="kicker"] { display: none; } .wx--quadrant .wx-now { margin-top: 0; gap: 10px; }
  .screen--portrait .wx--full .wx-head { flex-direction: column; gap: 14px; }
  /* color screens: rain in blue, the temperature in red */
  [class*="screen--color-"] .wx .wx-rain { fill: var(--bg-blue-color, #000); }
  [class*="screen--color-"] .wx .wx-temp { stroke: var(--bg-red-color, #000); }
</style>

<script>{% raw %}/*SCRIPT*/{% endraw %}</script>
